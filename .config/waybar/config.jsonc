{
  "reload_style_on_change": true,
  "exclusive": true,
  "position": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 1,
  "margin-bottom": 0,
  "margin-right": 0,
  "maring-left": 0,
  "modules-left": [
    "group/left1",
    "group/left2",
    "group/left3",
    "group/left4"
  ],

    "group/left1": {
    "orientation": "inherit",
    "modules": [
    "custom/omarchy"
    ]
  },

    "group/left2": {
    "orientation": "inherit",
    "modules": [
    "hyprland/workspaces",
    ]
  },

  "group/left3": {
    "orientation": "inherit",
    "modules": [
    "custom/updatespacman",
    "idle_inhibitor",
    "group/tray-expander2"
    ]
  },

    "group/left4": {
    "orientation": "inherit",
    "modules": ["mpris"]
  },

  "modules-center": [
    "clock",
    "custom/screenrecording-indicator",
    "custom/dot-indicator"
],

  "modules-right": ["group/right1", "group/right"],

   "group/right1": {
    "orientation": "inherit",
    "modules": ["group/tray-expander"]
  },

   "group/right": {
    "orientation": "inherit",
    "modules": [
    "network",
    "pulseaudio",
    "memory",
    "cpu",
    "battery"
  ]
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
      "1": "いち",
      "2": "に",
      "3": "さん",
      "4": "し",
      "5": "ご",
      "6": "ろく",
      "7": "しち",
      "8": "はち",
      "9": "きゅう",
      "10": "じゅう",
      "default": "・"
    },
    "persistent-workspaces": {
      "*": 8
    }
  },
  "custom/omarchy": {
    "format": "omarchy",
    "on-click": "app-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Menu\n\nSuper + Alt + Space"
  },
  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": " 󰏖",
      "updated": ""
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "󰾫"
    }
  },
  "cpu": {
    "interval": 10,
    "format": "cpu {usage}%",
    "on-click": "launch-btop"
  },
  "memory": {
    "interval": 2,
    "format": "mem {used:0.1f}G",
    "on-click": "launch-btop"
  },
  "clock": {
    "format": "{:%a %d ｜ %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
    "on-click-right": "mode"
  },
 "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}  ⇣ {bandwidthDownBits}  ⇡ {bandwidthUpBits}",
    "format-ethernet": "󰈀  ⇣ {bandwidthDownBits}  ⇡ {bandwidthUpBits}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 2,
    "spacing": 1,
    "on-click": "launch-wifi"
  },
   "battery": {
    "format": "bat {capacity}%",
    "format-discharging": "bat {capacity}%",
    "format-charging": "bat {capacity}%",
    "format-plugged": "bat_p {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "bat_f {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%\n {timeTo}",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%\n {timeTo}",
    "interval": 5,
    "on-click": "power-profile-menu",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "launch-bluetooth"
  },
    "pulseaudio": {
    "format": "vol {volume}%",
    "on-click": "launch-audio",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },
  "backlight": {
        "device": "intel_backlight",
        "rotate": 0,
        "format": "{icon}",
        "tooltip-format": "🌕 {percent}%",
            "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ]
   },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"    ]
  },
    "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },
  "custom/idle-indicator": {
    "on-click": "toggle-idle",
    "exec": "idle-status",
    "signal": 9,
    "return-type": "json"
  },
  "custom/notification-silencing-indicator": {
    "on-click": "toggle-notifications",
    "exec": "notification-status",
    "signal": 10,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 11,
    "spacing": 5
  },
 "group/tray-expander2": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
      "transition-left-to-right": true
    },
    "modules": [
    "custom/expand-icon2",
    "pulseaudio#icon",
    "backlight",
    "bluetooth",
    "power-profiles-daemon"
    ]
  },
  "custom/expand-icon2": {
    "format": "",
    "tooltip": false
  },
  "pulseaudio#icon": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "on-click": "launch-audio",
    "on-click-right": "pamixer -t",
    "tooltip-format": "{volume}%",
    "scroll-step": 5
  },

   "mpris": {
    "format": " {artist} - {title}",
    "format-paused": "<span color='grey'>{status_icon}  {title}</span>",
    "max-length": 75,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "󰝛"
    },
    "ignored-players": ["firefox", "chromium", "brave"]
  },
  "custom/dot-indicator": {
    "exec": "dot-status",
    "return-type": "json",
    "interval": 30,
    "signal": 11,
    "on-click": "dot-toggle",
    "tooltip": true
  },
  "custom/screenrecording-indicator": {
    "on-click": "screenrecord",
    "exec": "screenrecord-status",
    "signal": 8,
    "return-type": "json"
  },
}
