/* Generated by matugen - do not edit. Source: ~/.config/matugen/templates/ytm-cli.tcss
 *
 * Textual stylesheet for the ytm TUI. ytm layers this over its built-in CSS at
 * startup, so only colours belong here - layout stays in src/ytm/tui.py. */

Screen {
  background: {{colors.surface.default.hex}};
  color: {{colors.on_surface.default.hex}};
}

Header {
  background: {{colors.surface_container_high.default.hex}};
  color: {{colors.on_surface.default.hex}};
}

Footer {
  background: {{colors.surface_container.default.hex}};
  color: {{colors.on_surface_variant.default.hex}};
}

FooterKey .footer-key--key {
  background: {{colors.surface_container_high.default.hex}};
  color: {{colors.primary.default.hex}};
}

FooterKey .footer-key--description {
  background: {{colors.surface_container.default.hex}};
  color: {{colors.on_surface_variant.default.hex}};
}

/* Playlist pane */

#playlists {
  background: {{colors.surface_container_low.default.hex}};
  border-right: solid {{colors.outline_variant.default.hex}};
}

ListView > ListItem.-highlight {
  background: {{colors.primary.default.hex}};
  color: {{colors.on_primary.default.hex}};
}

/* Track table */

#tracks {
  background: {{colors.surface.default.hex}};
  color: {{colors.on_surface.default.hex}};
}

DataTable > .datatable--header {
  background: {{colors.surface_container.default.hex}};
  color: {{colors.on_surface_variant.default.hex}};
}

DataTable > .datatable--odd-row {
  background: {{colors.surface.default.hex}};
}

DataTable > .datatable--even-row {
  background: {{colors.surface_container_lowest.default.hex}};
}

DataTable > .datatable--hover {
  background: {{colors.surface_container.default.hex}};
}

DataTable > .datatable--cursor {
  background: {{colors.primary.default.hex}};
  color: {{colors.on_primary.default.hex}};
}

/* Search box */

#search {
  background: {{colors.surface_container.default.hex}};
  color: {{colors.on_surface.default.hex}};
  border: tall {{colors.outline_variant.default.hex}};
}

#search:focus {
  border: tall {{colors.primary.default.hex}};
}

/* Transport row */

#now {
  color: {{colors.primary.default.hex}};
}

#status {
  color: {{colors.on_surface_variant.default.hex}};
}

Bar > .bar--bar {
  color: {{colors.primary.default.hex}};
  background: {{colors.surface_container_high.default.hex}};
}

Bar > .bar--complete {
  color: {{colors.primary.default.hex}};
  background: {{colors.surface_container_high.default.hex}};
}
