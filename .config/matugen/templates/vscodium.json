  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.block.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.other"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator.key-value"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" }
    },
    {
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "{{colors.blue.default.hex}}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "entity.name.namespace"],
      "settings": { "foreground": "{{colors.cyan.default.hex}}" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "{{colors.green.default.hex}}" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp constant.character.escape"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["string.regexp", "string.other.link"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant"],
      "settings": { "foreground": "{{colors.orange.default.hex}}" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "{{colors.on_surface.default.hex}}" }
    },
    {
      "scope": ["variable.language", "variable.parameter.function.language.special.self.python"],
      "settings": { "foreground": "{{colors.error.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "{{colors.on_surface.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "{{colors.outline.default.hex}}" }
    },
    {
      "scope": ["punctuation.section", "meta.brace.round", "meta.brace.square", "meta.brace.curly"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" }
    },
    {
      "scope": ["meta.preprocessor", "keyword.control.directive", "keyword.control.import", "keyword.control.from"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "markup.link"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "{{colors.green.default.hex}}" }
    },
    {
      "scope": ["markup.list", "punctuation.definition.list"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "{{colors.green.default.hex}}" }
    },
    {
      "scope": ["markup.deleted", "invalid"],
      "settings": { "foreground": "{{colors.error.default.hex}}" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "{{colors.cyan.default.hex}}",
    "type": "{{colors.cyan.default.hex}}",
    "class": "{{colors.cyan.default.hex}}",
    "enum": "{{colors.cyan.default.hex}}",
    "interface": "{{colors.cyan.default.hex}}",
    "struct": "{{colors.cyan.default.hex}}",
    "typeParameter": "{{colors.cyan.default.hex}}",
    "enumMember": "{{colors.orange.default.hex}}",
    "function": "{{colors.blue.default.hex}}",
    "method": "{{colors.blue.default.hex}}",
    "macro": "{{colors.primary.default.hex}}",
    "decorator": "{{colors.tertiary.default.hex}}",
