#!/bin/bash
APP_ID="org.omarchy.btop"
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "btop" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)
if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  exec setsid xdg-terminal-exec --app-id="$APP_ID" -e btop
fi
