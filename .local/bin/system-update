#!/bin/bash

set -e
trap 'echo -e "\033[0;31m\nSomething went wrong! Review the output above.\033[0m"' ERR

# Inhibit idle/sleep during update
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Clock sync
echo -e "\e[32mSyncing clock\e[0m"
sudo systemctl restart systemd-timesyncd

# Btrfs snapshot (skipped silently if snapper not installed)
if command -v snapper &>/dev/null; then
  echo -e "\e[32m\nCreating system snapshot\e[0m"
  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')
  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number -d "pre-update-$(date +%Y%m%d)"
  done
fi

# System packages
echo -e "\e[32m\nUpdating system packages\e[0m"
sudo pacman -Syyu --noconfirm

# Print AUR upgrades that pin an exact repo version (dep=ver) the repo doesn't have yet.
# The omarchy snapshot mirror lags Arch by weeks, so AUR lib32-* bumps outrun it.
unsatisfiable_aur_upgrades() {
  local pending
  mapfile -t pending < <(paru -Qua 2>/dev/null | awk '{print $1}')
  ((${#pending[@]})) || return 0

  paru -Si --aur "${pending[@]}" 2>/dev/null | awk '
    /^Name/       { name = $3 }
    /^Depends On/ { sub(/^Depends On *: */, ""); n = split($0, deps, /  +/)
                    for (i = 1; i <= n; i++) if (deps[i] ~ /^[^<>]+=[^=]+$/) print name, deps[i] }
  ' | while read -r pkg pin; do
    local dep=${pin%%=*} wanted=${pin#*=} available
    available=$(pacman -Si "$dep" 2>/dev/null | awk '/^Version/ {print $3; exit}') || true
    [[ -z $available ]] && continue  # not a repo package (e.g. another AUR upgrade)
    [[ $wanted != *-* ]] && available=${available%-*}
    [[ $available == "$wanted" ]] || echo "$pkg $dep $wanted ${available}"
  done
}

# AUR packages
if pacman -Qem >/dev/null 2>&1; then
  echo -e "\e[32m\nUpdating AUR packages\e[0m"
  skip=()
  while read -r pkg dep wanted available; do
    echo -e "\e[33mSkipping $pkg: needs $dep=$wanted, repo has $available (mirror behind)\e[0m"
    skip+=("$pkg")
  done < <(unsatisfiable_aur_upgrades)
  ignore_list=$(IFS=,; echo "${skip[*]}")
  paru -Sua --cleanafter ${ignore_list:+--ignore "$ignore_list"}
fi

# Orphans
orphans=$(pacman -Qtdq 2>/dev/null || true)
if [[ -n $orphans ]]; then
  echo -e "\e[32m\nRemoving orphan packages\e[0m"
  for pkg in $orphans; do
    sudo pacman -Rs --noconfirm "$pkg" || true
  done
fi

# Post-update hook (user-owned, optional)
HOOK="$HOME/.config/omarchy/hooks/post-update"
[[ -f $HOOK ]] && bash "$HOOK"

# Re-enable idle
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true

# Reboot check
echo ""
running_hyprland=$(readlink /proc/$(pgrep -x Hyprland 2>/dev/null)/exe 2>/dev/null || true)
if ! pacman -Qo "/usr/lib/modules/$(uname -r)/pkgbase" &>/dev/null; then
  gum confirm "Kernel was updated. Reboot now?" && {
    setsid bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 </dev/null &
  } || true
elif [[ $running_hyprland == *"(deleted)"* ]]; then
  gum confirm "Hyprland was updated. Reboot now?" && {
    setsid bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 </dev/null &
  } || true
else
  echo -e "\e[32mAll done.\e[0m"
fi
