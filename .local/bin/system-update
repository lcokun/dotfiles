#!/bin/bash

set -e
trap 'echo -e "\033[0;31m\nSomething went wrong! Review the output above.\033[0m"' ERR

# Inhibit idle/sleep during update
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Clock sync
echo -e "\e[32mSyncing clock\e[0m"
sudo systemctl restart systemd-timesyncd

# Btrfs snapshot (skipped silently if snapper not installed)
if command -v snapper &>/dev/null; then
  echo -e "\e[32m\nCreating system snapshot\e[0m"
  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')
  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number -d "pre-update-$(date +%Y%m%d)"
  done
fi

# System packages
echo -e "\e[32m\nUpdating system packages\e[0m"
sudo pacman -Syyu --noconfirm

# AUR packages
if pacman -Qem >/dev/null 2>&1; then
  echo -e "\e[32m\nUpdating AUR packages\e[0m"
  paru -Sua --cleanafter
fi

# Orphans
orphans=$(pacman -Qtdq 2>/dev/null || true)
if [[ -n $orphans ]]; then
  echo -e "\e[32m\nRemoving orphan packages\e[0m"
  for pkg in $orphans; do
    sudo pacman -Rs --noconfirm "$pkg" || true
  done
fi

# Post-update hook (user-owned, optional)
HOOK="$HOME/.config/omarchy/hooks/post-update"
[[ -f $HOOK ]] && bash "$HOOK"

# Re-enable idle
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true

# Reboot check
echo ""
running_hyprland=$(readlink /proc/$(pgrep -x Hyprland 2>/dev/null)/exe 2>/dev/null || true)
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  gum confirm "Kernel was updated. Reboot now?" && {
    hyprctl clients -j | jq -r '.[].address' | xargs -I{} hyprctl dispatch closewindow address:{}
    sleep 1
    nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &
  }
elif [[ $running_hyprland == *"(deleted)"* ]]; then
  gum confirm "Hyprland was updated. Reboot now?" && {
    hyprctl clients -j | jq -r '.[].address' | xargs -I{} hyprctl dispatch closewindow address:{}
    sleep 1
    nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &
  }
else
  echo -e "\e[32mAll done.\e[0m"
fi
