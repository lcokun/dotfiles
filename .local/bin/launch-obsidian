#!/bin/bash
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "obsidian" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)
if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  exec setsid uwsm-app -- obsidian -disable-gpu --enable-wayland-ime
fi
